rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function circle(cid) { return get(/databases/$(database)/documents/findCircles/$(cid)); }
    function inCircle(cid) { return signedIn() && request.auth.uid in circle(cid).data.members; }

    // Pair codes: anyone signed in can look up a code they were given; nobody can list them.
    match /findCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/findCircles/$(request.resource.data.circleId)).data.members;
      allow list, update, delete: if false;
    }

    match /findCircles/{cid} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.joinCode is string;
      allow update: if signedIn() && (
        // Members can rename themselves, or remove one person (themselves when leaving, or someone else).
        (request.auth.uid in resource.data.members
          && request.resource.data.joinCode == resource.data.joinCode
          && (request.resource.data.members == resource.data.members
              || (resource.data.members.hasAll(request.resource.data.members)
                  && request.resource.data.members.size() == resource.data.members.size() - 1)))
        ||
        // Someone with the pair code can add only themselves.
        (request.resource.data.joinCodeUsed == resource.data.joinCode
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() <= 6
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'joinCodeUsed']))
      );
      allow delete: if false;

      // Each phone writes only its own location; everyone in the circle can see all of them.
      match /locations/{uid} {
        allow read: if inCircle(cid);
        allow create, update: if inCircle(cid) && request.auth.uid == uid;
        allow delete: if inCircle(cid);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
